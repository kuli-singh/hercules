EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Optional override if you want Hercules to use a non-default AI endpoint.
# If unset, Hercules uses ${EXPO_PUBLIC_SUPABASE_URL}/functions/v1/openai.
# Do not put raw provider secrets in Expo public variables.
# EXPO_PUBLIC_HERCULES_AI_URL=https://your-api.example.com/hercules-ai
